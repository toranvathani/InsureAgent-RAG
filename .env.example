LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-key-here

# Embeddings run locally via sentence-transformers — no API key needed.

VECTOR_BACKEND=pgvector
CHROMA_PATH=./chroma_db

# Recommended: use Neon (https://neon.tech) — serverless Postgres with pgvector
# built in. Free tier, no Docker/local install needed. Enable the extension
# once via Neon's SQL Editor: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require
DB_POOL_MAX_CONN=5